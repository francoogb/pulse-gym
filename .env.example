# Copia este archivo a .env.local y reemplaza los valores. Nunca subas .env.local.

# Acceso a la app (usuario y contraseña del formulario de inicio de sesión)
PULSE_USERNAME=
PULSE_PASSWORD=

# Secreto para firmar la cookie de sesión.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PULSE_SESSION_SECRET=

# Claves para notificaciones push (VAPID).
# Genera un par con: npx web-push generate-vapid-keys
PULSE_VAPID_PUBLIC_KEY=
PULSE_VAPID_PRIVATE_KEY=
NEXT_PUBLIC_PULSE_VAPID_PUBLIC_KEY=
PULSE_VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Opcional: ruta de la base de datos (por defecto, gym.db en la carpeta del proyecto)
# PULSE_DB_PATH=

# Opcional: ruta a cli.js de Claude Code si la detección automática no la encuentra (ver README)
# CLAUDE_CLI_ENTRY=
